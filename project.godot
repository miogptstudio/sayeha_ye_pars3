; Engine configuration file.
; Godot 4.x project — سایه‌های پارس
; Ready for PBR materials, custom shaders, and high-quality rendering.

config_version=5

[application]

config/name="سایه‌های پارس"
config/name_localized={
"en": "Shadows of Pars"
}
config/description="بازی بقا و اکتشاف سه‌بعدی در سرزمین باستانی پارس — نسخه Godot با پشتیبانی PBR و شیدر"
config/version="11.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://assets/icon.png"


[autoload]

GameManager="*res://scripts/game_manager.gd"


[audio]


[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

